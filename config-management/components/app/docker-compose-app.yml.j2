
services:
# ------------------------------------------ 
# 2. App層: Backend Application (ビジネスロジック) 
# ------------------------------------------ 
  app:
    image: python:3.11-slim
    container_name: python-app
    restart: unless-stopped
    user: "1000:1000"
    deploy:
      resources:
        limits:
          memory: 512M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    environment:
      DB_HOST: mysql-db
      DB_NAME: "{{ mysql_db_name }}"
      DB_USER: "{{ mysql_user }}"
      DB_PASS: "{{ mysql_password }}"
    volumes:
      - ./app:/app
    working_dir: /app
    command: python3 -m http.server 8000
    networks:
      - frontend-nw
      - backend-nw

# ========================================== 
# ネットワーク定義                            
# ========================================== 
networks:
# Webコンテナ側で作成される外部ネットワークへの相乗り 
  frontend-nw:
    external: true
# DBコンテナ側で作成される内部ネットワークへの相乗り 
  backend-nw:
    external: true