services:
  web:
    image: nginx:stable-alpine
    container_name: nginx-web
    restart: unless-stopped
    user: "0:0"
    ports:
      - "8080:80"
    volumes:
      - ./nginx-container.conf:/etc/nginx/conf.d/default.conf:ro
      - ./html:/usr/share/nginx/html:ro
    networks:
      - frontend-nw
    entrypoint: ["nginx", "-g", "daemon off;"]

networks:
  frontend-nw:
    external: true