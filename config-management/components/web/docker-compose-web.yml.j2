
services:
  web:
    image: nginx:stable-alpine
    container_name: nginx-web
    restart: unless-stopped

    # 【重要】エントリーポイントの干渉を避けるため、直接起動します
    command: ["nginx", "-g", "daemon off;"] 
    deploy:
      resources:
        limits:
          memory: 256M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    ports:
      - "8080:80"
    volumes:
      # 【修正点】コンテナ実行用ディレクトリ配下にファイルを配置している想定でパスを修正
      - ./nginx-container.conf:/etc/nginx/conf.d/default.conf:ro
      - ./html:/usr/share/nginx/html:ro
    networks:
      - frontend-nw

networks:
  frontend-nw:
    external: true