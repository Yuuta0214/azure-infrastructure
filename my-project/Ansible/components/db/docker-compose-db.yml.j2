version: '3.8'

services:
  {# ------------------------------------------ -#}
  {# 1. DB層: MySQL (データの永続化と隔離)      -#}
  {# ------------------------------------------ -#}
  db:
    image: mysql:8.0
    container_name: mysql-db
    restart: unless-stopped
    # DBは重要リソースのためメモリ多めに確保
    deploy:
      resources:
        limits:
          memory: 1G
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"
      MYSQL_DATABASE: "{{ mysql_db_name }}"
      MYSQL_USER: "{{ mysql_user }}"
      MYSQL_PASSWORD: "{{ mysql_password }}"
    volumes:
      # ホスト側の db_data ボリュームを MySQL のデータ保存先にマウント
      - db_data:/var/lib/mysql
    networks:
      - backend-nw
    # DB起動完了を正確に判定するためのヘルスチェック
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -u root -p{{ mysql_root_password }}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 45s

{# ========================================== -#}
{# ネットワーク定義                            -#}
{# ========================================== -#}
networks:
  backend-nw:
    driver: bridge
    internal: true

{# ========================================== -#}
{# ボリューム定義 (データの永続化)            -#}
{# ========================================== -#}
volumes:
  # MySQL のデータを VM が再起動・コンテナ破棄されても保持するための領域
  db_data:
    driver: local