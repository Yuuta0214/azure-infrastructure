version: '3.8'

services:
  {# ------------------------------------------ -#}
  {# 1. DB層: MySQL (データの永続化と隔離)      -#}
  {# ------------------------------------------ -#}
  db:
    image: mysql:8.0
    container_name: mysql-db
    restart: unless-stopped
    environment:
      {# 値が空の場合はデフォルトとして 'root' を設定しコンテナ起動失敗を回避 -#}
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password | default('root') }}"
      MYSQL_DATABASE: "{{ mysql_db_name | default('webdb') }}"
      MYSQL_USER: "{{ mysql_user | default('webuser') }}"
      MYSQL_PASSWORD: "{{ mysql_password | default('webpass') }}"
    volumes:
      {# ホスト側の db_data ボリュームを MySQL のデータ保存先にマウント -#}
      - db_data:/var/lib/mysql
    networks:
      - backend-nw
    {# DB起動完了を正確に判定するためのヘルスチェック -#}
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -u root -h localhost"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 15s

{# ========================================== -#}
{# ネットワーク定義                            -#}
{# ========================================== -#}
networks:
  {# DB/App層をインターネットから隔離するための内部ネットワーク -#}
  backend-nw:
    driver: bridge
    internal: true

{# ========================================== -#}
{# ボリューム定義 (データの永続化)            -#}
{# ========================================== -#}
volumes:
  {# MySQL のデータを VM が再起動・コンテナ破棄されても保持するための領域 -#}
  db_data:
    driver: local